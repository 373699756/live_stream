          <mxGeometry x="1290" y="500" width="260" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="switchNote4" value="频繁切换 WebRTC / FLV / HLS 时，HLS 不能等客户端请求后冷启动；运行中的 H.264/H.265 码流持续维护短 segment window，切到 HLS 时直接返回已有 playlist/segment。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontSize=17;fontStyle=1;fontColor=#334155;align=center;" vertex="1" parent="1">
          <mxGeometry x="270" y="720" width="1260" height="90" as="geometry"/>
        </mxCell>
