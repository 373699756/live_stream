{
    "name": "live-stream-ipc-web",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "vite --host 0.0.0.0",
        "build": "node scripts/build.mjs",
        "preview": "vite preview --host 0.0.0.0",
        "typecheck": "tsc --noEmit",
        "lint": "npm run typecheck",
        "test": "vitest run --passWithNoTests",
        "format": "prettier --write \"package.json\" \".prettierrc.json\" \"src/**/*.{ts,tsx,css}\"",
        "format:check": "prettier --check \"package.json\" \".prettierrc.json\" \"src/**/*.{ts,tsx,css}\""
    },
    "dependencies": {
        "react": "^19.0.0",
        "react-dom": "^19.0.0"
    },
    "devDependencies": {
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@vitejs/plugin-react": "^5.0.0",
        "prettier": "^3.8.4",
        "typescript": "^5.8.0",
        "vite": "^7.0.0",
        "vitest": "^4.1.8"
    }
}
