set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR arm)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)

if(NOT DEFINED CMAKE_C_COMPILER AND DEFINED ENV{CROSS_CC} AND NOT "$ENV{CROSS_CC}" STREQUAL "")
  set(CMAKE_C_COMPILER "$ENV{CROSS_CC}")
endif()
if(NOT DEFINED CMAKE_CXX_COMPILER AND DEFINED ENV{CROSS_CXX} AND NOT "$ENV{CROSS_CXX}" STREQUAL "")
  set(CMAKE_CXX_COMPILER "$ENV{CROSS_CXX}")
endif()
if(NOT DEFINED CMAKE_AR AND DEFINED ENV{CROSS_AR} AND NOT "$ENV{CROSS_AR}" STREQUAL "")
  set(CMAKE_AR "$ENV{CROSS_AR}")
endif()
if(NOT DEFINED CMAKE_RANLIB AND DEFINED ENV{CROSS_RANLIB} AND NOT "$ENV{CROSS_RANLIB}" STREQUAL "")
  set(CMAKE_RANLIB "$ENV{CROSS_RANLIB}")
endif()
if(NOT DEFINED CMAKE_STRIP AND DEFINED ENV{CROSS_STRIP} AND NOT "$ENV{CROSS_STRIP}" STREQUAL "")
  set(CMAKE_STRIP "$ENV{CROSS_STRIP}")
endif()

if(NOT DEFINED CMAKE_C_COMPILER)
  find_program(CMAKE_C_COMPILER arm-himix200-linux-gcc REQUIRED)
endif()
if(NOT DEFINED CMAKE_CXX_COMPILER)
  find_program(CMAKE_CXX_COMPILER arm-himix200-linux-g++ REQUIRED)
endif()
if(NOT DEFINED CMAKE_AR)
  find_program(CMAKE_AR arm-himix200-linux-ar REQUIRED)
endif()
if(NOT DEFINED CMAKE_RANLIB)
  find_program(CMAKE_RANLIB arm-himix200-linux-ranlib REQUIRED)
endif()
if(NOT DEFINED CMAKE_STRIP)
  find_program(CMAKE_STRIP arm-himix200-linux-strip)
endif()

set(COMMON_FLAGS "-mcpu=cortex-a7 -mfloat-abi=softfp -mfpu=neon-vfpv4 -fPIC")
set(CMAKE_C_FLAGS_INIT "${COMMON_FLAGS}")
set(CMAKE_CXX_FLAGS_INIT "${COMMON_FLAGS}")

set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
