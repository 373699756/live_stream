SET(CMAKE_SYSTEM_NAME Linux)
SET(CMAKE_SYSTEM_PROCESSOR arm)
if(NOT DEFINED CMAKE_C_COMPILER AND DEFINED ENV{CROSS_CC} AND NOT "$ENV{CROSS_CC}" STREQUAL "")
  SET(CMAKE_C_COMPILER "$ENV{CROSS_CC}")
endif()
if(NOT DEFINED CMAKE_CXX_COMPILER AND DEFINED ENV{CROSS_CXX} AND NOT "$ENV{CROSS_CXX}" STREQUAL "")
  SET(CMAKE_CXX_COMPILER "$ENV{CROSS_CXX}")
endif()

if(NOT DEFINED CMAKE_C_COMPILER)
  find_program(CMAKE_C_COMPILER arm-himix200-linux-gcc REQUIRED)
endif()
if(NOT DEFINED CMAKE_CXX_COMPILER)
  find_program(CMAKE_CXX_COMPILER arm-himix200-linux-g++ REQUIRED)
endif()
