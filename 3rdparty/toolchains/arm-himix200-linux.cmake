set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR arm)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)

set(TOOLCHAIN_ROOT "/opt/arm-himix200-linux/bin")
set(CMAKE_C_COMPILER "${TOOLCHAIN_ROOT}/arm-himix200-linux-gcc")
set(CMAKE_CXX_COMPILER "${TOOLCHAIN_ROOT}/arm-himix200-linux-g++")
set(CMAKE_AR "${TOOLCHAIN_ROOT}/arm-himix200-linux-ar")
set(CMAKE_RANLIB "${TOOLCHAIN_ROOT}/arm-himix200-linux-ranlib")
set(CMAKE_STRIP "${TOOLCHAIN_ROOT}/arm-himix200-linux-strip")

set(COMMON_FLAGS "-mcpu=cortex-a7 -mfloat-abi=softfp -mfpu=neon-vfpv4 -fPIC")
set(CMAKE_C_FLAGS_INIT "${COMMON_FLAGS}")
set(CMAKE_CXX_FLAGS_INIT "${COMMON_FLAGS}")

set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
