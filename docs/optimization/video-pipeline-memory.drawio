          <mxGeometry x="880" y="280" width="260" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="reader4" value="FrameReader ring&lt;br&gt;GOP start data + live queue&lt;br&gt;slow reader waits keyframe" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E0F2FE;strokeColor=#0284C7;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="880" y="440" width="260" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="webrtc4" value="WebRTC preview&lt;br&gt;low latency&lt;br&gt;requires peer + keyframe" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#EDE9FE;strokeColor=#7C3AED;fontSize=16;fontStyle=1;" vertex="1" parent="1">
