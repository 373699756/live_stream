        <mxCell id="hlsPes" value="PES header&lt;br&gt;PTS/DTS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=13;" vertex="1" parent="1">
